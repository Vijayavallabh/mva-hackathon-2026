{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vijayavallabh/mva-hackathon-2026/blob/main/notes/track2-four-arm-protocol-schema-v57.json",
  "title": "Qualified four-arm drug experiment schema",
  "description": "Machine-readable structure for a genotype-controlled drug experiment using all-enrolled founder-cell outcomes. This schema does not validate biological thresholds or authorize any clinical use.",
  "type": "object",
  "required": [
    "protocol_version",
    "disease_gene",
    "genetic_states",
    "interventions",
    "arms",
    "primary_endpoint",
    "enrollment",
    "outcome_states",
    "stop_rules"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "disease_gene": {
      "type": "object",
      "required": ["gene", "variants", "phase_status"],
      "properties": {
        "gene": {"type": "string", "const": "BUB1B"},
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^p\\.[A-Za-z0-9]+$"}
        },
        "phase_status": {
          "type": "string",
          "enum": ["unconfirmed", "cis", "trans"]
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["model_type", "qualification_status"],
      "properties": {
        "model_type": {"type": "string"},
        "qualification_status": {
          "type": "string",
          "enum": ["unqualified", "qualified", "failed"]
        },
        "endogenous_deficit": {"type": "boolean"},
        "independent_restoration": {"type": "boolean"}
      }
    },
    "genetic_states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": ["deficient", "corrected"]
      }
    },
    "interventions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": ["vehicle", "everolimus", "other_conditional_probe"]
      }
    },
    "arms": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["genetic_state", "intervention"],
        "properties": {
          "genetic_state": {"type": "string", "enum": ["deficient", "corrected"]},
          "intervention": {"type": "string", "enum": ["vehicle", "everolimus", "other_conditional_probe"]}
        }
      }
    },
    "primary_endpoint": {
      "type": "object",
      "required": ["name", "numerator", "denominator"],
      "properties": {
        "name": {"type": "string", "const": "useful_output"},
        "numerator": {
          "type": "string",
          "const": "accurate divisions yielding viable daughters during prespecified follow-up"
        },
        "denominator": {
          "type": "string",
          "const": "all founder cells enrolled before exposure"
        }
      }
    },
    "enrollment": {
      "type": "object",
      "required": ["before_exposure", "independent_unit"],
      "properties": {
        "before_exposure": {"type": "boolean", "const": true},
        "independent_unit": {
          "type": "string",
          "enum": ["culture", "clone", "donor"]
        },
        "nested_cells": {"type": "boolean", "const": true}
      }
    },
    "outcome_states": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "enum": ["accurate_division", "erroneous_division", "death", "persistent_arrest", "slippage", "tracking_loss"]
      }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["state", "decision"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["failed_assay", "unknown_or_imprecise", "benefit_excluded", "injury_exceeded", "unmatched_exposure", "all_requirements_met"]
          },
          "decision": {
            "type": "string",
            "enum": ["hold_inference", "hold_advancement", "stop_tested_claim", "stop_despite_apparent_benefit", "block_translational_promotion", "preclinical_review_only"]
          }
        }
      }
    }
  }
}
